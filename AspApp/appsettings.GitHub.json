{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "OidcIssuer": "https://yourDomainName",
  "OidcServerEncryptionKey": "YourEncryptionKey",

  "MongoDb": {
    "ConnectionString": "mongodb://mongodb:27017",
    "UserDbName": "Users_Db",
    "ProfileCollectionName": "Profile"
  },

  "Turnstile": {
    "Enabled": false,
    "SecretKey": "your-secret-key"
  }
}
